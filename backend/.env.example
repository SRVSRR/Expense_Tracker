# Supabase Transaction pooler URL on port 6543.
DATABASE_URL=postgresql+asyncpg://postgres.<project-ref>:<password>@<pooler-host>:6543/postgres
SECRET_KEY=replace-with-a-long-random-development-value
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Comma-separated list of allowed CORS origins (no wildcards outside tests).
# Required when TESTING != 1 — startup fails fast if unset.
CORS_ORIGINS=http://localhost:3000,http://localhost:8081

# Supabase Auth (Phase 1: additive — do not remove SECRET_KEY yet)
# Find these in Supabase Dashboard → Project Settings → API
SUPABASE_JWKS_URL=https://<project-ref>.supabase.co/auth/v1/.well-known/jwks.json
SUPABASE_ISSUER=https://<project-ref>.supabase.co/auth/v1